## .NET / C# gitignore

# Build output
bin/
obj/
out/
publish/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json

# Test results
TestResults/
*.trx
coverage/
*.coverage
*.coveragexml
lcov.info

# Environment & secrets — NEVER commit these
.env
.env.*
appsettings.Development.json
appsettings.Local.json
secrets.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
